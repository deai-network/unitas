{
  "name": "vultus-react-router",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "A vultus ArgStore over react-router 7's location: argument values live in the URL query (antd-free)",
  "repository": { "type": "git", "url": "git+https://github.com/deai-network/unitas.git", "directory": "packages/vultus-react-router" },
  "author": "Kristof Csillag <kristof.csillag@deai-labs.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/__tests__", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
      "./package.json": "./package.json"
    }
  },
  "scripts": { "build": "rm -rf dist && tsc -p tsconfig.build.json", "prepack": "pnpm run build", "test": "vitest run" },
  "dependencies": {
    "vultus-core": "workspace:^"
  },
  "peerDependencies": { "react": ">=18", "react-router": ">=7" },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "i18next": "^25.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.0",
    "react-router": "^7.18.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
