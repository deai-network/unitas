{
  "name": "vultus-core",
  "version": "0.5.7",
  "license": "Apache-2.0",
  "description": "Framework-neutral action model + hooks for vultus (antd-free by design)",
  "repository": { "type": "git", "url": "git+https://github.com/deai-network/unitas.git", "directory": "packages/vultus-core" },
  "author": "Kristof Csillag <kristof.csillag@deai-labs.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./link": "./src/LinkContext.tsx",
    "./changes": "./src/changes.ts",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/__tests__", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
      "./link": { "types": "./dist/LinkContext.d.ts", "import": "./dist/LinkContext.js", "default": "./dist/LinkContext.js" },
      "./changes": { "types": "./dist/changes.d.ts", "import": "./dist/changes.js", "default": "./dist/changes.js" },
      "./package.json": "./package.json"
    }
  },
  "scripts": { "build": "rm -rf dist && tsc -p tsconfig.build.json", "prepack": "pnpm run build", "test": "vitest run", "typecheck": "tsc -p tsconfig.json" },
  "peerDependencies": { "react": ">=18", "react-i18next": ">=15" },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "diff-match-patch": "^1.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "i18next": "^25.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
