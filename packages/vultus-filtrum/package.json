{
  "name": "vultus-filtrum",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "vultus field definitions and their values to a filtrum predicate, on the server or in the browser (React-free)",
  "repository": { "type": "git", "url": "git+https://github.com/deai-network/unitas.git", "directory": "packages/vultus-filtrum" },
  "author": "Kristof Csillag <kristof.csillag@deai-labs.com>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "!src/**/__tests__", "!src/**/*.test.ts", "!src/**/*.test.tsx", "README.md"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
      "./package.json": "./package.json"
    }
  },
  "scripts": { "build": "rm -rf dist && tsc -p tsconfig.build.json", "prepack": "pnpm run build", "test": "vitest run", "typecheck": "tsc -p tsconfig.json" },
  "dependencies": { "filtrum-core": "^0.1.1" },
  "peerDependencies": { "vultus-core": "workspace:^" },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "vultus-core": "workspace:*"
  }
}
